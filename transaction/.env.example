### BASE
SERVICE_NAME=auth
NODE_ENV=local

### HTTР
HTTP_PORT=9001
HTTP_HOST=localhost
HTTP_PREFIX=/api/auth
HTTP_VERSION=1

### DATABASE

DB_TYPE=postgres

DB_HOST=localhost

DB_PORT=5432

DB_DATABASE=account

DB_USERNAME=postgres

DB_PASSWORD=postgres

DB_LOGGING=false

DB_ENTITIES=dist/**/*.entity.js

DB_MIGRATIONS=dist/module/database/migrations/*.js

DB_MIGRATIONS_RUN=true

DB_MIGRATIONS_TABLE_NAME=database_migrations

### JWT

JWT_ALG=HS256

JWT_ACCESS_SECRET=accessSecret

JWT_ACCESS_EXP=1h

JWT_REFRESH_SECRET=refreshSecret

JWT_REFRESH_EXP=24h

### ACCOUNT

ACCOUNT_URL=http://localhost:9000/api/account