{
  "name": "@lab/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js"
    },
    "./kafka": {
    "types": "./dist/kafka/index.d.ts",
    "import": "./dist/kafka/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "peerDependencies": {
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/microservices": "^12",
    "ioredis": "^5",
    "kafkajs": "^2"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/microservices": "^12.0.1",
    "@types/node": "^24.0.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "typescript": "^6.0.2"
  }
}
